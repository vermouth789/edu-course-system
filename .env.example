# App
APP_ENV=development
APP_NAME=EduSpark
APP_HOST=127.0.0.1
APP_PORT=8000

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=1440

# Database
DATABASE_URL=postgresql+psycopg://eduspark:eduspark@127.0.0.1:5432/eduspark
REDIS_URL=redis://127.0.0.1:6379/0

# Vector Database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=course_knowledge

# Chat / Reasoning LLM
LLM_PROVIDER=longcat
LLM_API_KEY=ak_2Uo17Q7Hd2hH32d3db2vn53m9Lr2c
LLM_BASE_URL=https://api.longcat.chat/openai
LLM_MODEL=LongCat-Flash-Thinking-2601

# Teacher Agent
TEACHER_AGENT_MODEL=LongCat-Flash-Thinking-2601
TEACHER_AGENT_TEMPERATURE=0.3
TEACHER_AGENT_MAX_CONTEXT_CHUNKS=8

# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Local File Storage
LOCAL_STORAGE_DIR=./storage/uploads
